# Optional. Enables LLM homepage sketches. Without these, a styled template is used.
GROQ_API_KEY=

# Optional. Sends same-day booking requests over HTTPS via Resend.
# RESEND_API_KEY=

# Optional. Paste codes from Google Search Console and Bing Webmaster.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# GROQ_MODEL=llama-3.3-70b-versatile

# Or OpenAI instead of Groq:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
